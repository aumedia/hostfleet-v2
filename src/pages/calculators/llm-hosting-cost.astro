---
import Layout from "../../layouts/Layout.astro";
import pricing from "../../data/gpu-pricing.json";
const updated = pricing.updated;

// Pull the GPU rates the calculator uses from the live data file so they never drift apart.
function rate(gpuId, providerId) {
  const g = pricing.gpus.find((x) => x.id === gpuId);
  return g?.prices?.[providerId]?.hr ?? null;
}
const calcData = {
  updated,
  presets: {
    "8b":  { label: "7–8B (e.g. Llama 3.1 8B)",  gpu: "l40s",    gpuLabel: "L40S 48 GB",    tps: 60, sls: rate("l40s", "runpod_sls"),    pod: rate("l40s", "runpod_pods") },
    "13b": { label: "13B class",                  gpu: "l40s",    gpuLabel: "L40S 48 GB",    tps: 40, sls: rate("l40s", "runpod_sls"),    pod: rate("l40s", "runpod_pods") },
    "32b": { label: "30–34B (e.g. Qwen 32B)",     gpu: "a100_80", gpuLabel: "A100 80 GB",    tps: 35, sls: rate("a100_80", "runpod_sls"), pod: rate("a100_80", "runpod_pods") },
    "70b": { label: "70B (e.g. Llama 3.3 70B)",   gpu: "h100",    gpuLabel: "H100 80 GB",    tps: 25, sls: rate("h100", "runpod_sls"),    pod: rate("h100", "runpod_pods") }
  }
};
---
<Layout
  title="LLM hosting cost calculator: serverless GPU vs always-on vs per-token API — HostFleet"
  description="Estimate what it costs per month to serve an open LLM: serverless GPU, always-on GPU, or a per-token gateway. Every assumption is visible and editable."
>
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-24">
    <div class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">calculators</div>
    <h1 class="text-4xl font-semibold tracking-tight mt-2">What does it cost to host an LLM?</h1>
    <p class="mt-3 max-w-3xl text-[var(--color-text-dim)] text-lg">
      The real question behind "AI hosting" is almost always: serverless GPU, always-on GPU, or just pay
      per token? This calculator compares all three for your traffic. It is an <strong>estimate</strong> —
      every assumption is shown below and editable. GPU rates come from our
      <a href="/gpu-pricing/" class="underline">live pricing table</a> (verified {updated}).
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5 space-y-4">
        <h2 class="font-mono text-sm text-[var(--color-accent)]">// your workload</h2>
        <label class="block text-sm">Model size
          <select id="preset" class="mt-1 w-full rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-2 font-mono text-sm">
            <option value="8b">7–8B (e.g. Llama 3.1 8B)</option>
            <option value="13b">13B class</option>
            <option value="32b">30–34B (e.g. Qwen 32B)</option>
            <option value="70b" selected>70B (e.g. Llama 3.3 70B)</option>
          </select>
        </label>
        <label class="block text-sm">Requests per day
          <input id="reqs" type="number" value="2000" min="1" class="mt-1 w-full rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-2 font-mono text-sm" />
        </label>
        <label class="block text-sm">Avg tokens generated per request (output)
          <input id="toks" type="number" value="500" min="1" class="mt-1 w-full rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-2 font-mono text-sm" />
        </label>
      </div>

      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5 space-y-4">
        <h2 class="font-mono text-sm text-[var(--color-accent)]">// assumptions (edit me)</h2>
        <label class="block text-sm">Throughput on <span id="gpu-label" class="font-mono"></span> (tokens/sec)
          <input id="tps" type="number" value="25" min="1" class="mt-1 w-full rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-2 font-mono text-sm" />
          <span class="text-xs text-[var(--color-text-dim)]">Default is a conservative single-request figure, not a measured benchmark. Batch serving can be several times higher — edit to match your setup.</span>
        </label>
        <label class="block text-sm">Serverless GPU rate ($/hr)
          <input id="slsrate" type="number" step="0.01" class="mt-1 w-full rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-2 font-mono text-sm" />
        </label>
        <label class="block text-sm">Always-on GPU rate ($/hr)
          <input id="podrate" type="number" step="0.01" class="mt-1 w-full rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-2 font-mono text-sm" />
        </label>
        <label class="block text-sm">Per-token gateway price ($ per 1M output tokens, blended)
          <input id="gwrate" type="number" step="0.01" value="0.80" class="mt-1 w-full rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-2 font-mono text-sm" />
          <span class="text-xs text-[var(--color-text-dim)]">Set this from the gateway you'd actually use (OpenRouter, Together, Groq, Fireworks…). Default $0.80/1M is a placeholder, not a quote.</span>
        </label>
      </div>
    </div>

    <div id="results" class="mt-8 grid gap-4 md:grid-cols-3"></div>

    <div class="mt-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-sm text-[var(--color-text-dim)]" id="verdict"></div>

    <div class="mt-10 rounded-lg border border-[var(--color-border)] p-5 text-sm text-[var(--color-text-dim)]">
      <h2 class="font-mono text-sm text-[var(--color-accent)]">// what this deliberately ignores</h2>
      <ul class="mt-2 list-disc pl-5 space-y-1">
        <li>Cold starts and minimum billed idle on serverless (adds cost at low, spiky traffic).</li>
        <li>Input-token pricing on gateways (we use one blended output rate — tune it).</li>
        <li>Batching: a busy endpoint serves many requests concurrently, cutting effective GPU-hours. Our model bills sequential GPU-seconds, which overestimates serverless cost at high volume.</li>
        <li>Storage, egress, and the engineering time of running your own endpoint.</li>
      </ul>
      <p class="mt-3">GPU serverless/always-on defaults use RunPod's published rates from the <a href="/gpu-pricing/" class="underline">live table</a>; swap in any provider's rate. For provider selection, read <a href="/runpod-vs-modal-vs-replicate-small-inference-api/" class="underline">RunPod vs Modal vs Replicate</a>.</p>
    </div>
  </section>

  <script is:inline define:vars={{ calcData }}>
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => n >= 100 ? "$" + Math.round(n).toLocaleString() : "$" + n.toFixed(2);

    function applyPreset() {
      const p = calcData.presets[$("preset").value];
      $("tps").value = p.tps;
      $("slsrate").value = p.sls;
      $("podrate").value = p.pod;
      $("gpu-label").textContent = p.gpuLabel;
      calc();
    }

    function calc() {
      const reqs = +$("reqs").value || 0;
      const toks = +$("toks").value || 0;
      const tps = +$("tps").value || 1;
      const sls = +$("slsrate").value || 0;
      const pod = +$("podrate").value || 0;
      const gw = +$("gwrate").value || 0;

      const tokensPerDay = reqs * toks;
      const busyHrsPerDay = tokensPerDay / tps / 3600;
      const slsMo = busyHrsPerDay * 30 * sls;
      const podMo = 24 * 30 * pod;
      const gwMo = (tokensPerDay * 30 / 1e6) * gw;

      const opts = [
        { name: "Serverless GPU", cost: slsMo, sub: busyHrsPerDay.toFixed(1) + " busy GPU-hrs/day @ $" + sls + "/hr" },
        { name: "Always-on GPU", cost: podMo, sub: "24/7 @ $" + pod + "/hr" },
        { name: "Per-token gateway", cost: gwMo, sub: (tokensPerDay * 30 / 1e6).toFixed(1) + "M tokens/mo @ $" + gw + "/1M" }
      ];
      const min = Math.min(...opts.map(o => o.cost));
      $("results").innerHTML = opts.map(o => `
        <div class="rounded-lg border ${o.cost === min ? "border-[var(--color-accent)]" : "border-[var(--color-border)]"} bg-[var(--color-surface)] p-5">
          <div class="font-mono text-xs ${o.cost === min ? "text-[var(--color-accent)]" : "text-[var(--color-text-dim)]"}">${o.name}${o.cost === min ? " · cheapest" : ""}</div>
          <div class="text-3xl font-semibold mt-2">${fmt(o.cost)}<span class="text-sm font-normal text-[var(--color-text-dim)]">/mo</span></div>
          <div class="text-xs text-[var(--color-text-dim)] mt-2">${o.sub}</div>
        </div>`).join("");

      let verdict;
      if (min === gwMo) {
        verdict = "At this volume a per-token gateway wins — you are paying only for tokens, and someone else owns the GPU. Self-hosting starts to make sense when monthly gateway spend approaches the always-on figure, or when you need data control or custom models.";
      } else if (min === slsMo) {
        verdict = "Serverless GPU wins: your traffic keeps a GPU busy for only " + busyHrsPerDay.toFixed(1) + " hours/day, so paying per second beats renting 24/7. Watch cold starts if traffic is spiky.";
      } else {
        verdict = "Always-on GPU wins: your traffic keeps a GPU busy more than ~" + Math.round(podMo / sls / 30) + " hrs/day, so a dedicated instance is cheaper than per-second serverless billing — and batching will stretch it further.";
      }
      $("verdict").innerHTML = "<span class='font-mono text-[var(--color-accent)]'>// verdict</span><p class='mt-2'>" + verdict + "</p>";
    }

    $("preset").addEventListener("change", applyPreset);
    ["reqs", "toks", "tps", "slsrate", "podrate", "gwrate"].forEach(id => $(id).addEventListener("input", calc));
    applyPreset();
  </script>
</Layout>
