---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, category, legacy } = post.data;
const relatedPosts = (await getCollection("posts"))
  .filter((p) => !p.data.draft && p.id !== post.id && p.data.category === category)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 3);
const categoryHubs = {
  "ai-hosting": "/ai-hosting/",
  edge: "/edge/",
  "deploy-ai-apps": "/deploy-ai-apps/",
  "legacy-wp": "/legacy-hosting/",
  guide: "/",
};
const categoryNames = {
  "ai-hosting": "AI Hosting",
  edge: "Edge",
  "deploy-ai-apps": "Deploy AI Apps",
  "legacy-wp": "Legacy Hosting",
  guide: "HostFleet",
};
const categoryHref = categoryHubs[category] ?? "/";
const categoryName = categoryNames[category] ?? "HostFleet";

const url = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/og-default.png", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: author,
    jobTitle: "Senior Infrastructure Analyst",
    url: new URL("/about/", Astro.site).toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "HostFleet",
    url: Astro.site?.toString(),
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  image: ogImage,
  articleSection: category,
};
---
<Layout title={`${title} — HostFleet`} description={description} image={ogImage}>
  {legacy && <Fragment slot="head"><meta name="robots" content="noindex,follow" /></Fragment>}
  <article class="max-w-3xl mx-auto px-6 py-16">
    <div class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)] mb-4">{category}</div>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-[1.1]">{title}</h1>
    <div class="mt-4 font-mono text-sm text-[var(--color-text-dim)]">
      By {author} · <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
    </div>
    <div class="mt-10 prose-invert text-[var(--color-text)] leading-relaxed [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:my-5 [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_a]:text-[var(--color-accent)] [&_a:hover]:underline [&_code]:font-mono [&_code]:text-sm [&_code]:bg-[var(--color-surface)] [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_pre]:bg-[var(--color-surface)] [&_pre]:p-4 [&_pre]:rounded-lg [&_pre]:overflow-x-auto [&_table]:w-full [&_table]:my-6 [&_table]:border-collapse [&_th]:border [&_th]:border-[var(--color-border)] [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:bg-[var(--color-surface)] [&_td]:border [&_td]:border-[var(--color-border)] [&_td]:px-3 [&_td]:py-2 [&_hr]:my-10 [&_hr]:border-[var(--color-border)] [&_strong]:font-semibold [&_strong]:text-white [&_em]:text-[var(--color-text-dim)]">
      <Content />
    </div>
  </article>
  <section class="max-w-3xl mx-auto px-6 pb-20">
    <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
      <div class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-dim)]">Continue reading</div>
      <div class="mt-2 text-xl font-semibold">More from {categoryName}</div>
      <p class="mt-3 text-sm text-[var(--color-text-dim)]">Use the category hub if you want the fuller cluster, or jump into the closest related reads below.</p>
      <div class="mt-4">
        <a href={categoryHref} class="font-mono text-sm text-[var(--color-accent)] hover:underline">Browse {categoryName} →</a>
      </div>
      {relatedPosts.length > 0 && (
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {relatedPosts.map((related) => (
            <a href={`/${related.id}/`} class="block rounded-lg border border-[var(--color-border)] p-4 hover:border-[var(--color-accent)] transition">
              <div class="font-semibold leading-tight">{related.data.title}</div>
              <div class="mt-2 text-sm text-[var(--color-text-dim)]">{related.data.description}</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Layout>
