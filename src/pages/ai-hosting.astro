---
import Layout from "../layouts/Layout.astro";
import ResearchLibrary from "../components/ResearchLibrary.astro";
import { getCollection } from "astro:content";
import pricing from "../data/gpu-pricing.json";

let posts = [];
try { posts = await getCollection("posts"); } catch {}
posts = posts
  .filter((post) => !post.data.draft && post.data.category === "ai-hosting")
  .sort((a, b) => +new Date(b.data.updatedDate ?? b.data.pubDate) - +new Date(a.data.updatedDate ?? a.data.pubDate));

const providerName = (id) => pricing.providers.find((provider) => provider.id === id)?.name ?? id;
function best(gpuId) {
  const gpu = pricing.gpus.find((item) => item.id === gpuId);
  if (!gpu) return null;
  return Object.entries(gpu.prices).map(([provider, cell]) => ({ provider: providerName(provider), rate: cell.hr })).sort((a, b) => a.rate - b.rate)[0];
}
const quickGpus = [
  { size: "8B", memory: "16 GB", gpu: "T4", best: best("t4"), tone: "blue" },
  { size: "24B", memory: "24 GB", gpu: "L4", best: best("l4"), tone: "lime" },
  { size: "32B", memory: "32 GB", gpu: "RTX 5090", best: best("rtx5090"), tone: "violet" },
  { size: "70B", memory: "48 GB", gpu: "A40", best: best("a6000"), tone: "orange" },
];
---

<Layout title="How to host an AI model — visual guide | HostFleet" description="A simple visual guide to model APIs, serverless GPUs, dedicated GPU hosting, VRAM sizing, and the real difference between hosting an agent and hosting a model.">
  <section class="page-shell model-hero">
    <div>
      <span class="eyebrow">Model hosting, explained</span>
      <h1>Where does an AI model actually run?</h1>
      <p>Your app does not need a GPU just because it uses AI. First decide whether another company serves the model, a GPU wakes up on demand, or you keep the hardware running yourself.</p>
      <div class="hero-actions"><a href="#choose">Show me the three paths →</a><a href="/calculators/llm-hosting-cost/">Calculate the cost</a></div>
    </div>
    <div class="hosting-anatomy soft-card">
      <div class="anatomy-app"><small>Your server</small><strong>App or agent</strong><span>CPU is usually enough</span></div>
      <div class="anatomy-call"><b>API call</b><i>→</i></div>
      <div class="anatomy-model"><small>Inference server</small><strong>Open model</strong><span>GPU is used here</span><em>▦</em></div>
      <div class="anatomy-rule"><b>Rule of thumb</b><span>Separate orchestration from inference before choosing hardware.</span></div>
    </div>
  </section>

  <section class="page-shell misconception">
    <div class="misconception__bad"><span>Common assumption</span><strong>“I am building an agent, so I need a GPU.”</strong></div>
    <div class="misconception__arrow">→</div>
    <div class="misconception__good"><span>Better mental model</span><strong>Agent = CPU workflow<br/>Model = API or GPU</strong></div>
  </section>

  <section class="page-shell choose-section" id="choose">
    <div class="section-heading"><div><span class="eyebrow">Choose the operating model</span><h2>Same AI. Very different job.</h2></div><p>Move right only when the extra control solves a real requirement. Complexity has a monthly cost even when the dashboard calls the GPU cheap.</p></div>
    <div class="choice-board">
      <article class="choice-card choice-card--api">
        <div class="choice-icon">☁</div><span class="choice-step">Path 1 · easiest</span><h3>Model API</h3><p>A provider owns the model server and GPUs. Your product sends requests.</p>
        <div class="choice-meter"><span>Operations</span><i><b style="width:18%"></b></i><strong>Low</strong></div>
        <dl><div><dt>Choose it when</dt><dd>You need to ship, test demand, or support changing usage.</dd></div><div><dt>Watch for</dt><dd>Usage spend, data policy, and provider limits.</dd></div></dl>
        <a href="/openrouter-vs-together-vs-groq-vs-fireworks/">Compare managed paths →</a>
      </article>
      <article class="choice-card choice-card--serverless">
        <div class="choice-icon">ϟ</div><span class="choice-step">Path 2 · flexible</span><h3>Serverless GPU</h3><p>Your model image runs on rented GPU workers that can scale down.</p>
        <div class="choice-meter"><span>Operations</span><i><b style="width:52%"></b></i><strong>Medium</strong></div>
        <dl><div><dt>Choose it when</dt><dd>You need custom weights, burst jobs, or an isolated endpoint.</dd></div><div><dt>Watch for</dt><dd>Cold starts, storage, worker minimums, and quotas.</dd></div></dl>
        <a href="/serverless-gpu-pricing-matrix-2026/">Compare serverless GPU hosts →</a>
      </article>
      <article class="choice-card choice-card--own">
        <div class="choice-icon">▦</div><span class="choice-step">Path 3 · most control</span><h3>Always-on GPU</h3><p>You rent a GPU instance and operate the full serving stack.</p>
        <div class="choice-meter"><span>Operations</span><i><b style="width:88%"></b></i><strong>High</strong></div>
        <dl><div><dt>Choose it when</dt><dd>Load is steady and measured, or dedicated capacity is required.</dd></div><div><dt>Watch for</dt><dd>Idle bill, availability, drivers, security, and scaling.</dd></div></dl>
        <a href="/gpu-pricing/">See current GPU rates →</a>
      </article>
    </div>
  </section>

  <section class="vram-section">
    <div class="page-shell">
      <div class="section-heading"><div><span class="eyebrow">Fast capacity check</span><h2>Model size → first GPU to test</h2></div><p>For 4-bit inference, short context, and one active sequence. This answers “might it fit?”, not “will it be fast enough?”</p></div>
      <div class="gpu-cards">
        {quickGpus.map((item) => (
          <a href="/what-gpu-to-run-llama-70b/" class={`gpu-card gpu-card--${item.tone}`}>
            <span class="label-estimated">Estimated</span><strong>{item.size}</strong><small>model class</small>
            <div class="gpu-card__chip"><i></i><b>{item.memory}</b><em>VRAM target</em></div>
            <div class="gpu-card__footer"><span>{item.gpu}</span><span>{item.best ? `$${item.best.rate.toFixed(2)}/hr` : "—"}</span></div>
          </a>
        ))}
      </div>
      <div class="vram-caveat"><span class="label-sourced">Sourced + estimated</span><p>Parameter counts are sourced from official model cards. Weight memory and first-test tiers are transparent estimates. Quantization metadata, runtime, KV cache, long context, batching, and concurrent users need headroom.</p><a href="/what-gpu-to-run-llama-70b/">Open the complete VRAM guide →</a></div>
    </div>
  </section>

  <section class="page-shell decision-checklist">
    <div class="section-heading"><div><span class="eyebrow">Before renting hardware</span><h2>Five questions. In this order.</h2></div><p>If you cannot answer traffic and control requirements yet, an API is a reversible default.</p></div>
    <ol>
      <li><span>1</span><div><strong>Do I need custom weights?</strong><small>No → begin with an API.</small></div></li>
      <li><span>2</span><div><strong>Must inference stay in my environment?</strong><small>No → keep outsourcing GPU operations.</small></div></li>
      <li><span>3</span><div><strong>Is traffic bursty or steady?</strong><small>Bursty → serverless. Steady → price a warm instance.</small></div></li>
      <li><span>4</span><div><strong>What actually fits in VRAM?</strong><small>Include context, cache, and concurrency — not only weights.</small></div></li>
      <li><span>5</span><div><strong>What did the exact workload measure?</strong><small>Use peak VRAM, latency, utilization, and total monthly bill.</small></div></li>
    </ol>
    <a class="checklist-cta" href="/calculators/llm-hosting-cost/"><span>Now compare the monthly shapes</span><strong>Open the hosting cost calculator →</strong></a>
  </section>

  <div class="page-shell"><ResearchLibrary posts={posts} title="Model hosting research library" intro="All the detailed provider comparisons, pricing source trails, implementation caveats, and experiment notes remain available here without dominating the page." limit={9} /></div>
</Layout>

<style>
  .model-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(3rem,8vw,8rem);align-items:center;padding-top:6rem}.model-hero h1{max-width:730px;margin-top:1.3rem;font-size:clamp(3.2rem,7vw,6.4rem);line-height:.91;letter-spacing:-.07em}.model-hero>div>p{max-width:630px;margin-top:1.5rem;color:var(--color-text-dim);font-size:1.15rem;line-height:1.7}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.8rem}.hero-actions a{padding:.85rem 1.2rem;border:1px solid #bac3b7;border-radius:999px;font-weight:750}.hero-actions a:first-child{border-color:#162036;background:#162036;color:white}.hosting-anatomy{padding:1.4rem;background:linear-gradient(150deg,#fff,#eef3ec)}.anatomy-app,.anatomy-model{position:relative;padding:1.4rem;border:1px solid var(--color-border);border-radius:17px;background:white}.anatomy-app small,.anatomy-app strong,.anatomy-app span,.anatomy-model small,.anatomy-model strong,.anatomy-model span{display:block}.anatomy-app small,.anatomy-model small{color:#697587;font:700 .62rem var(--font-mono);text-transform:uppercase}.anatomy-app strong,.anatomy-model strong{margin-top:.3rem;font-size:1.2rem}.anatomy-app span,.anatomy-model span{margin-top:.25rem;color:var(--color-text-dim);font-size:.75rem}.anatomy-model{background:#eee8ff}.anatomy-model em{position:absolute;right:1rem;top:1rem;display:grid;width:3rem;height:3rem;place-items:center;border-radius:12px;background:#7951bc;color:white;font-size:1.4rem;font-style:normal}.anatomy-call{display:flex;height:70px;align-items:center;justify-content:center;gap:1rem}.anatomy-call b{padding:.35rem .55rem;border-radius:6px;background:#e7ebe4;color:#657183;font:700 .6rem var(--font-mono)}.anatomy-call i{font-size:1.5rem;font-style:normal}.anatomy-rule{display:flex;gap:.8rem;margin-top:1rem;padding:1rem;border-radius:13px;background:#162036;color:white}.anatomy-rule b{flex:none;color:#b9f43b;font-size:.75rem}.anatomy-rule span{color:#bac4d3;font-size:.72rem;line-height:1.5}.misconception{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:center;margin-top:6rem;padding-block:1.2rem;border-block:1px solid var(--color-border)}.misconception>div:not(.misconception__arrow){padding:1.2rem;border-radius:16px}.misconception__bad{background:#fff1e8}.misconception__good{background:#e8f8c6}.misconception span,.misconception strong{display:block}.misconception span{margin-bottom:.35rem;color:#687486;font:700 .6rem var(--font-mono);text-transform:uppercase}.misconception strong{font-size:1.05rem;line-height:1.35}.misconception__arrow{font-size:1.5rem}.choose-section,.decision-checklist{padding-top:7rem}.choice-board{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.choice-card{padding:1.4rem;border:1px solid var(--color-border);border-radius:24px;background:white}.choice-icon{display:grid;width:4rem;height:4rem;place-items:center;margin-bottom:1.3rem;border-radius:18px;font-size:1.8rem}.choice-card--api .choice-icon{background:#dcf5ff;color:#087fae}.choice-card--serverless .choice-icon{background:#e6f8bf;color:#4c7200}.choice-card--own .choice-icon{background:#eee7ff;color:#7049ae}.choice-step{color:#737f8f;font:700 .62rem var(--font-mono);text-transform:uppercase}.choice-card h3{margin-top:.4rem;font-size:1.8rem;letter-spacing:-.04em}.choice-card>p{min-height:73px;margin-top:.7rem;color:var(--color-text-dim);font-size:.86rem;line-height:1.55}.choice-meter{display:grid;grid-template-columns:auto 1fr auto;gap:.6rem;align-items:center;margin:1rem 0;padding:.8rem;border-radius:11px;background:#f1f4ef;font-size:.65rem}.choice-meter i{height:7px;border-radius:20px;background:#d7ddd3;overflow:hidden}.choice-meter b{display:block;height:100%;border-radius:20px;background:#162036}.choice-card dl{margin:0}.choice-card dl>div{padding:.8rem 0;border-top:1px solid var(--color-border)}.choice-card dt{font-size:.7rem;font-weight:800}.choice-card dd{margin-top:.25rem;color:var(--color-text-dim);font-size:.75rem;line-height:1.45}.choice-card>a{display:block;margin-top:.9rem;color:#087fae;font-size:.78rem;font-weight:750}.vram-section{margin-top:7rem;padding:6rem 0;background:#162036;color:white}.vram-section .eyebrow{border-color:#40506d;background:#24314c;color:#d4dce8}.vram-section .section-heading p{color:#abb6c6}.gpu-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.gpu-card{padding:1.2rem;border:1px solid #3d4b65;border-radius:20px;background:#202d48}.gpu-card>strong,.gpu-card>small{display:block}.gpu-card>strong{margin-top:1rem;font-size:2.5rem;letter-spacing:-.06em}.gpu-card>small{color:#aeb8c7}.gpu-card__chip{position:relative;height:120px;margin-top:1rem;padding:1rem;border-radius:14px;overflow:hidden}.gpu-card__chip i{position:absolute;width:120px;height:120px;right:-35px;bottom:-45px;border:20px solid currentColor;border-radius:30px;transform:rotate(20deg);opacity:.18}.gpu-card__chip b,.gpu-card__chip em{position:relative;display:block}.gpu-card__chip b{font-size:1.45rem}.gpu-card__chip em{margin-top:.2rem;font-size:.68rem;font-style:normal}.gpu-card--blue .gpu-card__chip{background:#dff5ff;color:#087fae}.gpu-card--lime .gpu-card__chip{background:#e7f9c1;color:#4b7400}.gpu-card--violet .gpu-card__chip{background:#eee7ff;color:#6e42b5}.gpu-card--orange .gpu-card__chip{background:#fff0df;color:#b45b00}.gpu-card__footer{display:flex;justify-content:space-between;margin-top:1rem;font:700 .7rem var(--font-mono)}.vram-caveat{display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;margin-top:1rem;padding:1rem;border-radius:14px;background:#0f192c}.vram-caveat p{color:#adb7c6;font-size:.73rem;line-height:1.5}.vram-caveat a{color:#b9f43b;font-size:.75rem;font-weight:750}.decision-checklist ol{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;list-style:none}.decision-checklist li{position:relative;padding:1.1rem;border-block:1px solid var(--color-border);border-right:1px solid var(--color-border)}.decision-checklist li:first-child{border-left:1px solid var(--color-border);border-radius:18px 0 0 18px}.decision-checklist li:last-child{border-radius:0 18px 18px 0}.decision-checklist li>span{display:grid;width:2rem;height:2rem;place-items:center;margin-bottom:2rem;border-radius:50%;background:#162036;color:white;font:700 .7rem var(--font-mono)}.decision-checklist strong,.decision-checklist small{display:block}.decision-checklist strong{font-size:.85rem;line-height:1.3}.decision-checklist small{margin-top:.5rem;color:var(--color-text-dim);font-size:.7rem;line-height:1.45}.checklist-cta{display:flex;align-items:center;justify-content:space-between;margin-top:1rem;padding:1rem 1.2rem;border-radius:15px;background:#b9f43b}.checklist-cta span{font-size:.8rem}.checklist-cta strong{font-size:.85rem}
  @media(max-width:900px){.model-hero{grid-template-columns:1fr}.hosting-anatomy{max-width:600px}.choice-board{grid-template-columns:1fr}.choice-card>p{min-height:0}.gpu-cards{grid-template-columns:repeat(2,1fr)}.vram-caveat{grid-template-columns:1fr}.decision-checklist ol{grid-template-columns:1fr}.decision-checklist li,.decision-checklist li:first-child,.decision-checklist li:last-child{border:1px solid var(--color-border);border-bottom:0;border-radius:0}.decision-checklist li:first-child{border-radius:18px 18px 0 0}.decision-checklist li:last-child{border-bottom:1px solid var(--color-border);border-radius:0 0 18px 18px}.decision-checklist li>span{margin-bottom:1rem}}
  @media(max-width:560px){.model-hero{padding-top:3rem}.misconception{grid-template-columns:1fr}.misconception__arrow{transform:rotate(90deg);text-align:center}.gpu-cards{grid-template-columns:1fr}.checklist-cta{align-items:flex-start;flex-direction:column;gap:.6rem}}
</style>
