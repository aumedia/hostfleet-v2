---
import Layout from "../layouts/Layout.astro";
import ResearchLibrary from "../components/ResearchLibrary.astro";
import { getCollection } from "astro:content";
import pricing from "../data/gpu-pricing.json";

let posts = [];
try { posts = await getCollection("posts"); } catch {}
posts = posts
  .filter((post) => !post.data.draft && !post.data.legacy)
  .sort((a, b) => +new Date(b.data.updatedDate ?? b.data.pubDate) - +new Date(a.data.updatedDate ?? a.data.pubDate));

const featuredIds = [
  "serverless-gpu-pricing-matrix-2026",
  "what-gpu-to-run-llama-70b",
  "best-hosting-for-ai-agents-on-a-budget",
  "where-to-deploy-lovable-bolt-v0-apps",
  "ai-generated-app-production-footguns",
  "cost-to-run-ai-side-project-on-vps-30-days",
];
const featured = featuredIds.map((id) => posts.find((post) => post.id === id)).filter(Boolean);

const providerName = (id) => pricing.providers.find((provider) => provider.id === id)?.name ?? id;
function cheapestFor(gpuId) {
  const gpu = pricing.gpus.find((item) => item.id === gpuId);
  if (!gpu) return null;
  const matches = Object.entries(gpu.prices)
    .filter(([, cell]) => typeof cell?.hr === "number")
    .map(([provider, cell]) => ({ rate: cell.hr, provider: providerName(provider) }))
    .sort((a, b) => a.rate - b.rate);
  return matches[0] ?? null;
}

const modelGuide = [
  { model: "Qwen3 8B", params: "8B", target: "16 GB", gpu: "T4", rate: cheapestFor("t4"), width: 18 },
  { model: "Mistral Small 24B", params: "24B", target: "24 GB", gpu: "L4", rate: cheapestFor("l4"), width: 34 },
  { model: "Qwen3 32B", params: "32B", target: "32 GB", gpu: "RTX 5090", rate: cheapestFor("rtx5090"), width: 52 },
  { model: "Llama 3.3 70B", params: "70B", target: "48 GB", gpu: "A40 / A6000", rate: cheapestFor("a6000"), width: 84 },
];

const cardsTracked = pricing.gpus.length;
const providersTracked = pricing.providers.length;
---

<Layout>
  <section class="page-shell hero-grid pb-18 pt-14 md:pt-24">
    <div class="hero-copy">
      <span class="eyebrow">AI infrastructure, made visible</span>
      <h1 class="display-title mt-7">Host AI.<br/><span>Without guessing.</span></h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-[var(--color-text-dim)] md:text-xl">
        See what runs where, what hardware it needs, and what it can cost — before you deploy anything.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#start" class="hero-primary rounded-full bg-[#162036] px-6 py-3.5 font-bold shadow-lg shadow-slate-900/10 transition hover:-translate-y-0.5">Find my hosting path →</a>
        <a href="/gpu-pricing/" class="rounded-full border border-[#b9c2b5] bg-white/70 px-6 py-3.5 font-bold transition hover:border-[#162036]">Compare live GPU prices</a>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-3 text-xs text-[var(--color-text-dim)]">
        <span class="label-sourced">Sourced</span><span>{cardsTracked} GPU types · {providersTracked} providers · verified {pricing.updated}</span>
      </div>
    </div>

    <div class="infra-map soft-card" aria-label="The three ways an AI product can access a model">
      <div class="infra-map__top">
        <span class="map-icon map-icon--app">✦</span>
        <div><small>Your product</small><strong>AI app or agent</strong></div>
      </div>
      <div class="infra-map__pipe"><span>needs intelligence</span></div>
      <div class="infra-map__routes">
        <a href="#paths" class="route-node route-node--api">
          <span>☁</span><small>Easiest</small><strong>Model API</strong><em>No GPU to manage</em>
        </a>
        <a href="#paths" class="route-node route-node--serverless">
          <span>ϟ</span><small>Flexible</small><strong>Serverless GPU</strong><em>Pay while it runs</em>
        </a>
        <a href="#paths" class="route-node route-node--gpu">
          <span>▦</span><small>More control</small><strong>Your GPU</strong><em>You operate it</em>
        </a>
      </div>
      <div class="infra-map__caption"><span>Simple</span><span>More control →</span></div>
    </div>
  </section>

  <section class="page-shell proof-strip" aria-label="What HostFleet tracks">
    <div><strong>{cardsTracked}</strong><span>GPU types tracked</span></div>
    <div><strong>{providersTracked}</strong><span>providers compared</span></div>
    <div><strong>3</strong><span>hosting paths explained</span></div>
    <div><strong>0</strong><span>fake benchmarks</span></div>
  </section>

  <section class="page-shell start-section" id="start">
    <div class="section-heading">
      <div><span class="eyebrow">Start with the workload</span><h2>What are you trying to run?</h2></div>
      <p>Pick the closest shape. We will separate the app server, the agent runtime, and the model so you do not buy a GPU for the wrong job.</p>
    </div>

    <div class="path-picker soft-card">
      <div class="path-tabs" role="tablist" aria-label="Choose your AI workload">
        <button class="path-tab is-active" role="tab" aria-selected="true" data-path="model"><span>◉</span> Run an open model</button>
        <button class="path-tab" role="tab" aria-selected="false" data-path="agent"><span>◎</span> Keep an agent online</button>
        <button class="path-tab" role="tab" aria-selected="false" data-path="app"><span>◇</span> Ship a generated app</button>
        <button class="path-tab" role="tab" aria-selected="false" data-path="feature"><span>✦</span> Add AI to a product</button>
      </div>

      <div class="path-panels">
        <div class="path-panel" role="tabpanel" data-path="model">
          <div class="path-answer">
            <span class="answer-kicker">Your first decision</span>
            <h3>Do you need to own model serving?</h3>
            <p>Use an API for the fastest start. Rent serverless GPU for custom weights or bursty jobs. Keep a GPU warm only after the workload proves it needs one.</p>
            <a class="arrow-link" href="/ai-hosting/">Open the model hosting guide</a>
          </div>
          <div class="mini-architecture">
            <div class="mini-node mini-node--app">Your app</div><span>→</span><div class="mini-node mini-node--gpu">Model endpoint</div>
            <small>GPU belongs here — not under the web app.</small>
          </div>
        </div>
        <div class="path-panel hidden" role="tabpanel" data-path="agent">
          <div class="path-answer">
            <span class="answer-kicker">The common surprise</span>
            <h3>Most agents need a CPU server, not a GPU.</h3>
            <p>The server keeps the worker, schedule, queue, memory, and tools alive. It can call a model API. Add a GPU only if the model itself must run on your infrastructure.</p>
            <a class="arrow-link" href="/best-hosting-for-ai-agents-on-a-budget/">See agent hosting options</a>
          </div>
          <div class="agent-diagram">
            <div><span>24/7 CPU</span><strong>Agent + tools</strong><em>usually $5–20/mo</em></div>
            <b>calls</b>
            <div><span>External</span><strong>Model API</strong><em>usage-based</em></div>
          </div>
        </div>
        <div class="path-panel hidden" role="tabpanel" data-path="app">
          <div class="path-answer">
            <span class="answer-kicker">From demo to production</span>
            <h3>Split the pretty frontend from the slow work.</h3>
            <p>Deploy the web shell at the edge, keep secrets and jobs in a backend, and put persistent data in a real database. The builder is the starting point, not the architecture.</p>
            <a class="arrow-link" href="/deploy-ai-apps/">See the 3-part deployment map</a>
          </div>
          <div class="stack-diagram"><div>Frontend<small>edge</small></div><span>→</span><div>Backend<small>CPU worker</small></div><span>→</span><div>Data<small>managed DB</small></div></div>
        </div>
        <div class="path-panel hidden" role="tabpanel" data-path="feature">
          <div class="path-answer">
            <span class="answer-kicker">Default starting point</span>
            <h3>Call an API before running a GPU.</h3>
            <p>It removes drivers, model servers, scaling, and idle cost. Revisit self-hosting when usage, privacy, custom weights, or dedicated capacity creates a measurable reason.</p>
            <a class="arrow-link" href="/openrouter-vs-together-vs-groq-vs-fireworks/">Compare managed model paths</a>
          </div>
          <div class="mini-architecture mini-architecture--api"><div class="mini-node mini-node--app">Your product</div><span>→</span><div class="mini-node mini-node--api">Model API</div><small>Start simple. Add infrastructure only when the numbers justify it.</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="page-shell paths-section" id="paths">
    <div class="section-heading">
      <div><span class="eyebrow">The core choice</span><h2>Three ways to use a model</h2></div>
      <p>There is no universal winner. Traffic shape, control, and engineering time change the answer.</p>
    </div>
    <div class="hosting-paths">
      <article class="hosting-card hosting-card--api">
        <div class="hosting-card__visual"><span>API</span><i></i><b>↗</b></div>
        <div class="hosting-card__number">01</div><h3>Use a model API</h3>
        <p>Best first move for most apps. No GPU setup, scaling, or idle hardware.</p>
        <ul><li><b>Best for</b> prototypes and variable usage</li><li><b>You manage</b> prompts and product code</li><li><b>Tradeoff</b> less infrastructure control</li></ul>
        <span class="path-verdict">Start here unless you know why not</span>
      </article>
      <article class="hosting-card hosting-card--serverless">
        <div class="hosting-card__visual"><span>GPU</span><i></i><b>ϟ</b></div>
        <div class="hosting-card__number">02</div><h3>Rent serverless GPU</h3>
        <p>Bring custom weights and pay for active compute. Cold starts and minimums still matter.</p>
        <ul><li><b>Best for</b> bursty jobs and custom models</li><li><b>You manage</b> image and inference code</li><li><b>Tradeoff</b> startup delay and limits</li></ul>
        <span class="path-verdict">Good bridge to self-hosting</span>
      </article>
      <article class="hosting-card hosting-card--dedicated">
        <div class="hosting-card__visual"><span>24/7</span><i></i><b>▦</b></div>
        <div class="hosting-card__number">03</div><h3>Keep a GPU running</h3>
        <p>Predictable capacity and maximum control — with a bill that continues while idle.</p>
        <ul><li><b>Best for</b> steady, measured workloads</li><li><b>You manage</b> the complete serving stack</li><li><b>Tradeoff</b> cost and operations</li></ul>
        <span class="path-verdict">Earn this complexity with data</span>
      </article>
    </div>
    <div class="paths-cta"><div><span class="label-estimated">Estimated</span><strong>Put your traffic into the calculator</strong><small>Compare usage-based API, serverless GPU, and always-on GPU monthly cost.</small></div><a href="/calculators/llm-hosting-cost/">Calculate my cost →</a></div>
  </section>

  <section class="model-section">
    <div class="page-shell">
      <div class="section-heading">
        <div><span class="eyebrow">VRAM, not vibes</span><h2>What GPU fits the model?</h2></div>
        <p>These are conservative first-test targets for 4-bit weights, short context, and one active sequence — capacity estimates, not performance benchmarks.</p>
      </div>
      <div class="model-board soft-card">
        <div class="model-board__scale"><span>Smaller model</span><span>More VRAM →</span></div>
        {modelGuide.map((item) => (
          <div class="model-row">
            <div class="model-row__name"><strong>{item.model}</strong><span>{item.params} parameters</span></div>
            <div class="model-row__bar"><i style={`width:${item.width}%`}></i><b>{item.target}</b></div>
            <div class="model-row__gpu"><strong>{item.gpu}</strong><span>{item.rate ? `from $${item.rate.rate.toFixed(2)}/hr` : "rate unavailable"}</span></div>
          </div>
        ))}
        <div class="model-board__note"><span class="label-sourced">Sourced + estimated</span><p>Model sizes come from official model cards. Raw weight math and first GPU targets are estimates with headroom. Context, concurrency, runtime, and quantization can require more.</p><a href="/what-gpu-to-run-llama-70b/">Read the sizing method →</a></div>
      </div>
    </div>
  </section>

  <section class="page-shell data-tools">
    <div class="section-heading">
      <div><span class="eyebrow">Useful before you deploy</span><h2>Tools, not another wall of text</h2></div>
      <p>Every tool exposes its inputs, claim type, source date, and limitations.</p>
    </div>
    <div class="tool-grid">
      <a href="/gpu-pricing/" class="tool-card tool-card--pricing"><div class="tool-card__art"><span>$0.39</span><span>$0.59</span><span>$1.39</span><i></i></div><span class="label-sourced">Sourced</span><h3>Live GPU price board</h3><p>Compare current public list rates across {providersTracked} providers.</p><strong>Open the price board →</strong></a>
      <a href="/calculators/llm-hosting-cost/" class="tool-card tool-card--calc"><div class="tool-card__art"><span>API</span><span>GPU</span><span>24/7</span><i></i></div><span class="label-estimated">Estimated</span><h3>Hosting cost calculator</h3><p>Change the model, traffic, throughput, and rates. See the crossover.</p><strong>Run your numbers →</strong></a>
      <a href="/serverless-gpu-pricing-matrix-2026/" class="tool-card tool-card--matrix"><div class="tool-card__art"><span>scale</span><span>cold</span><span>limits</span><i></i></div><span class="label-sourced">Sourced</span><h3>Serverless GPU matrix</h3><p>Price is only one axis. Compare billing, scale-to-zero, and constraints.</p><strong>Compare providers →</strong></a>
    </div>
  </section>

  <div class="page-shell"><ResearchLibrary posts={featured} title="Go deeper only when you need to" intro="The short visual answer comes first. These longer pages keep the source trail, assumptions, and implementation detail available for search, GEO, and serious buyers." limit={6} /></div>

  <script is:inline>
    (() => {
      const tabs = Array.from(document.querySelectorAll(".path-tab"));
      const panels = Array.from(document.querySelectorAll(".path-panel"));
      tabs.forEach((tab) => tab.addEventListener("click", () => {
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", String(active));
        });
        panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.path !== tab.dataset.path));
      }));
    })();
  </script>
</Layout>

<style>
  .hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:clamp(3rem,7vw,7rem);align-items:center}.hero-copy h1 span{color:#1a9bd3}.hero-primary{color:#fff!important}.infra-map{position:relative;padding:2rem;overflow:hidden;background:linear-gradient(145deg,#fff 0%,#f2f6ee 100%)}.infra-map::before{content:"";position:absolute;inset:0;background-image:radial-gradient(#b9c3b6 1px,transparent 1px);background-size:18px 18px;opacity:.28}.infra-map>*{position:relative}.infra-map__top{width:max-content;margin:auto;display:flex;align-items:center;gap:.8rem;padding:.8rem 1.15rem;border:1px solid #cfd6cd;border-radius:15px;background:white;box-shadow:0 8px 25px rgba(22,32,54,.08)}.infra-map__top small,.infra-map__top strong{display:block}.infra-map__top small{color:#707b8c;font:700 .62rem var(--font-mono);text-transform:uppercase}.infra-map__top strong{font-size:.95rem}.map-icon{display:grid;width:2.3rem;height:2.3rem;place-items:center;border-radius:10px;background:#162036;color:#b9f43b}.infra-map__pipe{height:88px;display:flex;align-items:center;justify-content:center}.infra-map__pipe::before{content:"";position:absolute;top:0;width:2px;height:88px;background:#adb8aa}.infra-map__pipe span{z-index:1;padding:.3rem .55rem;border-radius:20px;background:#e9ede6;color:#687486;font:650 .58rem var(--font-mono)}.infra-map__routes{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.infra-map__routes::before{content:"";position:absolute;left:16%;right:16%;top:-1rem;border-top:2px solid #adb8aa}.route-node{display:flex;min-width:0;flex-direction:column;align-items:center;padding:1rem .45rem;border:1px solid #cfd6cd;border-radius:16px;background:white;text-align:center;box-shadow:0 8px 18px rgba(22,32,54,.06);transition:.2s}.route-node:hover{transform:translateY(-4px);border-color:#96a38f}.route-node>span{display:grid;width:2.2rem;height:2.2rem;place-items:center;margin-bottom:.6rem;border-radius:10px;font-weight:800}.route-node--api>span{background:#dff5ff;color:#087fae}.route-node--serverless>span{background:#e5f9ba;color:#4b7400}.route-node--gpu>span{background:#eee7ff;color:#6e42b5}.route-node small{color:#7b8493;font:700 .55rem var(--font-mono);text-transform:uppercase}.route-node strong{margin-top:.2rem;font-size:.82rem}.route-node em{margin-top:.25rem;color:#7b8493;font-size:.62rem;font-style:normal}.infra-map__caption{display:flex;justify-content:space-between;margin-top:1.1rem;color:#7b8493;font:700 .58rem var(--font-mono);text-transform:uppercase}.proof-strip{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--color-border)}.proof-strip div{display:flex;align-items:center;gap:.8rem;padding:1.35rem;border-right:1px solid var(--color-border)}.proof-strip div:last-child{border-right:0}.proof-strip strong{font-size:1.7rem}.proof-strip span{color:var(--color-text-dim);font-size:.75rem;line-height:1.25}.start-section,.paths-section,.data-tools{padding-top:7.5rem}.path-picker{display:grid;grid-template-columns:280px 1fr;overflow:hidden}.path-tabs{padding:1rem;background:#eef1eb;border-right:1px solid var(--color-border)}.path-tab{display:flex;width:100%;align-items:center;gap:.8rem;padding:1rem;border:0;border-radius:13px;background:transparent;color:#596679;text-align:left;font-weight:700;cursor:pointer}.path-tab span{display:grid;width:2rem;height:2rem;place-items:center;border-radius:9px;background:white}.path-tab.is-active{background:#162036;color:white;box-shadow:0 10px 28px rgba(22,32,54,.15)}.path-tab.is-active span{background:#b9f43b;color:#162036}.path-panels{min-height:380px;padding:2.5rem}.path-panel{display:grid;grid-template-columns:1fr .88fr;gap:3rem;align-items:center}.path-answer .answer-kicker{color:#087fae;font:750 .67rem var(--font-mono);letter-spacing:.06em;text-transform:uppercase}.path-answer h3{max-width:530px;margin-top:.7rem;font-size:clamp(1.8rem,4vw,3rem);line-height:1;letter-spacing:-.045em}.path-answer p{max-width:560px;margin-top:1rem;color:var(--color-text