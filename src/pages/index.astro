---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import pricing from "../data/gpu-pricing.json";

let posts = [];
try { posts = await getCollection("posts"); } catch {}
posts = posts.filter(p => !p.data.draft && !p.data.legacy).sort((a,b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const recent = posts.slice(0, 6);

// Live snapshot: cheapest listed rate per headline GPU, straight from the data file.
const spotlightIds = ["h100", "a100_80", "l40s", "h200", "l4"];
const providerName = (id) => pricing.providers.find(p => p.id === id)?.name ?? id;
const spotlight = spotlightIds.map(id => {
  const g = pricing.gpus.find(x => x.id === id);
  if (!g) return null;
  let best = null;
  for (const [pid, cell] of Object.entries(g.prices)) {
    if (cell?.hr != null && (!best || cell.hr < best.hr)) best = { hr: cell.hr, pid };
  }
  return best ? { name: g.name, vram: g.vram, hr: best.hr, provider: providerName(best.pid) } : null;
}).filter(Boolean);
const updated = pricing.updated;
---
<Layout>
  <!-- HERO: question + live numbers -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-14">
    <div class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">The AI Infrastructure Review</div>
    <div class="mt-3 grid md:grid-cols-5 gap-10 items-start">
      <div class="md:col-span-3">
        <h1 class="text-5xl md:text-6xl font-semibold tracking-tight leading-[1.05]">Where should<br/>your AI app <span class="text-[var(--color-accent)]">live?</span></h1>
        <p class="mt-6 text-lg text-[var(--color-text-dim)]">GPU prices, verified twice a week. Cost calculators with honest assumptions. Deployment guides that name real tradeoffs. No "lightning fast!" claims — numbers you can check yourself.</p>
        <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
          <a href="/calculators/llm-hosting-cost/" class="px-4 py-2 rounded border border-[var(--color-accent)] text-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-black">Calculate your hosting cost →</a>
          <a href="/gpu-pricing/" class="px-4 py-2 rounded border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-text)]">Live GPU pricing →</a>
        </div>
      </div>
      <div class="md:col-span-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
        <div class="flex items-baseline justify-between">
          <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">// gpu spot check</h2>
          <span class="font-mono text-[10px] text-[var(--color-text-dim)]">verified {updated}</span>
        </div>
        <table class="mt-3 w-full text-sm">
          <tbody>
            {spotlight.map(s => (
              <tr class="border-b border-[var(--color-border)] last:border-0">
                <td class="py-2 font-mono">{s.name}</td>
                <td class="py-2 text-right font-semibold whitespace-nowrap">${s.hr.toFixed(2)}<span class="text-[var(--color-text-dim)] font-normal">/hr</span></td>
                <td class="py-2 pl-3 text-right text-xs text-[var(--color-text-dim)] whitespace-nowrap">{s.provider}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <a href="/gpu-pricing/" class="mt-3 inline-block font-mono text-xs text-[var(--color-accent)] hover:underline">full table: 14 GPUs × 6 providers →</a>
      </div>
    </div>
  </section>

  <!-- WORKLOAD PICKER -->
  <section class="max-w-5xl mx-auto px-6 pb-14">
    <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-dim)] mb-4">// what are you shipping?</h2>
    <div class="flex flex-wrap gap-2 font-mono text-sm" id="wl-tabs">
      <button data-wl="api" class="wl-tab px-4 py-2 rounded border border-[var(--color-accent)] text-[var(--color-accent)]">An inference API</button>
      <button data-wl="app" class="wl-tab px-4 py-2 rounded border border-[var(--color-border)]">An AI-generated app</button>
      <button data-wl="agent" class="wl-tab px-4 py-2 rounded border border-[var(--color-border)]">A 24/7 agent or worker</button>
      <button data-wl="rag" class="wl-tab px-4 py-2 rounded border border-[var(--color-border)]">RAG / vector search</button>
    </div>
    <div class="mt-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
      <div class="wl-panel" data-wl="api">
        <p class="text-[var(--color-text-dim)]">Serving a model behind an endpoint? The decision is serverless GPU vs always-on vs paying per token — it flips entirely on your traffic shape.</p>
        <div class="mt-4 flex flex-wrap gap-4 font-mono text-xs">
          <a class="underline hover:text-[var(--color-accent)]" href="/calculators/llm-hosting-cost/">run your numbers →</a>
          <a class="underline hover:text-[var(--color-accent)]" href="/runpod-vs-modal-vs-replicate-small-inference-api/">RunPod vs Modal vs Replicate →</a>
          <a class="underline hover:text-[var(--color-accent)]" href="/openrouter-vs-together-vs-groq-vs-fireworks/">or skip GPUs: per-token gateways →</a>
        </div>
      </div>
      <div class="wl-panel hidden" data-wl="app">
        <p class="text-[var(--color-text-dim)]">Lovable, Bolt, or v0 built it — now it needs production hosting, a real domain, and hardening before users hit it.</p>
        <div class="mt-4 flex flex-wrap gap-4 font-mono text-xs">
          <a class="underline hover:text-[var(--color-accent)]" href="/where-to-deploy-lovable-bolt-v0-apps/">where to deploy builder apps →</a>
          <a class="underline hover:text-[var(--color-accent)]" href="/ai-generated-app-production-footguns/">what breaks in production →</a>
          <a class="underline hover:text-[var(--color-accent)]" href="/best-edge-runtime-for-ai-generated-marketing-sites/">best edge runtime →</a>
        </div>
      </div>
      <div class="wl-panel hidden" data-wl="agent">
        <p class="text-[var(--color-text-dim)]">Agents don't fit request/response hosting: they need queues, cron, persistent processes, and hosts that don't kill long-running work.</p>
        <div class="mt-4 flex flex-wrap gap-4 font-mono text-xs">
          <a class="underline hover:text-[var(--color-accent)]" href="/best-hosting-for-ai-agents-on-a-budget/">budget agent hosting →</a>
          <a class="underline hover:text-[var(--color-accent)]" href="/best-hosts-for-long-running-agent-workers/">long-running workers →</a>
          <a class="underline hover:text-[var(--color-accent)]" href="/where-to-host-mcp-servers-for-small-teams/">hosting MCP servers →</a>
        </div>
      </div>
      <div class="wl-panel hidden" data-wl="rag">
        <p class="text-[var(--color-text-dim)]">Small RAG apps rarely need enterprise vector infrastructure. When pgvector is enough, when Qdrant wins, and when managed is worth the floor price.</p>
        <div class="mt-4 flex flex-wrap gap-4 font-mono text-xs">
          <a class="underline hover:text-[var(--color-accent)]" href="/vector-database-hosting-small-ai-apps/">vector DB hosting →</a>
          <a class="underline hover:text-[var(--color-accent)]" href="/cheapest-place-to-host-n8n-open-webui-qdrant/">cheapest n8n + Qdrant stack →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="max-w-5xl mx-auto px-6 pb-14">
    <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-dim)] mb-6">// tools — live data, not blog posts</h2>
    <div class="grid md:grid-cols-2 gap-6">
      <a href="/gpu-pricing/" class="block p-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] transition">
        <div class="font-mono text-xs text-[var(--color-accent)]">data / live table</div>
        <div class="mt-2 text-xl font-semibold">GPU cloud pricing</div>
        <div class="mt-3 text-sm text-[var(--color-text-dim)]">Every rate from RunPod, Modal, Fal, Baseten, and Replicate — verified against vendor pages twice a week, sortable, with the raw JSON downloadable.</div>
      </a>
      <a href="/calculators/llm-hosting-cost/" class="block p-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] transition">
        <div class="font-mono text-xs text-[var(--color-accent)]">calculator</div>
        <div class="mt-2 text-xl font-semibold">What does it cost to host an LLM?</div>
        <div class="mt-3 text-sm text-[var(--color-text-dim)]">Serverless GPU vs always-on vs per-token API for your traffic — every assumption visible and editable.</div>
      </a>
    </div>
  </section>

  <!-- PATHS -->
  <section class="max-w-5xl mx-auto px-6 pb-14">
    <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-dim)] mb-6">// guides by path</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <a href="/ai-hosting/" class="block p-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] transition">
        <div class="font-mono text-xs text-[var(--color-accent)]">ai-hosting</div>
        <div class="mt-2 text-lg font-semibold">Inference, GPUs, gateways, vectors</div>
      </a>
      <a href="/deploy-ai-apps/" class="block p-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] transition">
        <div class="font-mono text-xs text-[var(--color-accent)]">deploy-ai-apps</div>
        <div class="mt-2 text-lg font-semibold">Builder output → production</div>
      </a>
      <a href="/edge/" class="block p-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] transition">
        <div class="font-mono text-xs text-[var(--color-accent)]">edge</div>
        <div class="mt-2 text-lg font-semibold">Cloudflare, Vercel, Netlify tradeoffs</div>
      </a>
    </div>
  </section>

  <!-- RECENT -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-text-dim)] mb-6">// recent</h2>
    <ul class="space-y-4">
      {recent.map(p => (
        <li class="flex items-baseline justify-between gap-6 border-b border-[var(--color-border)] pb-4">
          <a href={`/${p.id}/`} class="hover:text-[var(--color-accent)] transition font-medium">{p.data.title}</a>
          <span class="font-mono text-xs text-[var(--color-text-dim)] whitespace-nowrap">{new Date(p.data.pubDate).toISOString().slice(0,10)}</span>
        </li>
      ))}
    </ul>
  </section>

  <script is:inline>
    (function () {
      const tabs = document.querySelectorAll(".wl-tab");
      const panels = document.querySelectorAll(".wl-panel");
      tabs.forEach(t => t.addEventListener("click", () => {
        tabs.forEach(x => x.classList.remove("border-[var(--color-accent)]", "text-[var(--color-accent)]"));
        tabs.forEach(x => x.classList.add("border-[var(--color-border)]"));
        t.classList.add("border-[var(--color-accent)]", "text-[var(--color-accent)]");
        t.classList.remove("border-[var(--color-border)]");
        panels.forEach(p => p.classList.toggle("hidden", p.dataset.wl !== t.dataset.wl));
      }));
    })();
  </script>
</Layout>
